APP_ENV=development
API_HOST=127.0.0.1
API_PORT=17890
CONSOLE_PORT=17891
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql+psycopg://learn_assistant:learn_assistant@127.0.0.1:5432/learn_assistant
DEFAULT_ORG_NAME=Local Workspace
DEFAULT_ADMIN_EMAIL=admin@example.local
DEFAULT_ADMIN_PASSWORD=change-me-local
LICENSE_KEY=
API_TOKEN_PEPPER=change-me-token-pepper
EXPORT_DIR=exports

# 大模型请求的 TLS / 代理设置(可选)
# 本机开着 Charles / mitmproxy / Fiddler 这类抓包代理时,它们会用自建根证书重签 TLS,
# httpx 默认只信任 certifi,测试连接会报 CERTIFICATE_VERIFY_FAILED。二选一:
#   1) 直连(推荐,抓包代理只为调试其他流量时用):
# LLM_DISABLE_PROXY=true
#   2) 仍然走代理,但额外信任一个 CA bundle(把代理根证书拼进 certifi 的 cacert.pem):
# LLM_CA_BUNDLE=C:\path\to\ca-bundle.pem
