# 单机 Docker 部署用的环境文件
# 用法：复制为 .env.production（不要提交），改掉密码与 pepper，再 docker compose up

# 生产环境：启动时会校验 API_TOKEN_PEPPER，默认值会直接拒绝启动
APP_ENV=production

# --- 数据库（compose 会用它拼 DATABASE_URL）---
POSTGRES_DB=learn_assistant
POSTGRES_USER=learn_assistant
# 密码里不要出现 @ : / 这类 URL 保留字符，否则拼出来的 DATABASE_URL 会解析失败
POSTGRES_PASSWORD=换成强密码

# --- 对外端口（浏览器访问 http://<主机>:<WEB_PORT>）---
WEB_PORT=8080

# --- 安全 ---
# 生成：openssl rand -hex 32
API_TOKEN_PEPPER=换成随机串
ALLOW_REGISTRATION=false

# --- 初始化（首次启动时用，之后可清空）---
DEFAULT_ORG_NAME=我的学习空间
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=换成初始管理员密码
LICENSE_KEY=

# --- 后台任务与保留策略 ---
# 单容器单进程保持 0；若将来多副本，调大到大于最长任务耗时
JOB_RECOVERY_GRACE_SECONDS=0
EXPORT_RETENTION_COUNT=50
EXPORT_RETENTION_DAYS=0
